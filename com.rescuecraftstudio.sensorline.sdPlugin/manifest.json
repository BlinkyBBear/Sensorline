{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.rescuecraftstudio.sensorline",
  "Name": "Sensorline",
  "Version": "1.1.0.0",
  "Author": "RescueCraft Studio",
  "Description": "Display any sensor AIDA64 Extreme is sharing. Sensorline reads the official External Applications interfaces — shared memory, WMI, and the registry — and lists every exported value: temperatures, fans, voltages, current, power, clocks, utilisation, disks, network, motherboard, cooling loops, probes, and custom sensors. Each key is a radial gauge, bar, readout, or sparkline, coloured by cold, normal, high and critical zones with a smooth gradient, a colour-blind safe palette, or your own colours.",
  "Icon": "imgs/plugin",
  "Category": "Sensorline",
  "CategoryIcon": "imgs/category",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Nodejs": {
    "Version": "20"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "ApplicationsToMonitor": {
    "windows": [
      "aida64.exe"
    ]
  },
  "Actions": [
    {
      "Name": "CPU",
      "UUID": "com.rescuecraftstudio.sensorline.cpu",
      "Icon": "imgs/actions/gauge",
      "Tooltip": "CPU utilisation from AIDA64.",
      "PropertyInspectorPath": "ui/monitor.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableCaching": true,
      "States": [
        {
          "Image": "imgs/actions/gauge-key"
        }
      ]
    },
    {
      "Name": "Memory",
      "UUID": "com.rescuecraftstudio.sensorline.memory",
      "Icon": "imgs/actions/gauge",
      "Tooltip": "Memory utilisation from AIDA64.",
      "PropertyInspectorPath": "ui/monitor.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableCaching": true,
      "States": [
        {
          "Image": "imgs/actions/gauge-key"
        }
      ]
    },
    {
      "Name": "Temperature",
      "UUID": "com.rescuecraftstudio.sensorline.temperature",
      "Icon": "imgs/actions/gauge",
      "Tooltip": "Hottest matching temperature from AIDA64.",
      "PropertyInspectorPath": "ui/monitor.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableCaching": true,
      "States": [
        {
          "Image": "imgs/actions/gauge-key"
        }
      ]
    },
    {
      "Name": "Fan",
      "UUID": "com.rescuecraftstudio.sensorline.fan",
      "Icon": "imgs/actions/gauge",
      "Tooltip": "Fan speed from AIDA64.",
      "PropertyInspectorPath": "ui/monitor.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableCaching": true,
      "States": [
        {
          "Image": "imgs/actions/gauge-key"
        }
      ]
    },
    {
      "Name": "GPU",
      "UUID": "com.rescuecraftstudio.sensorline.gpu",
      "Icon": "imgs/actions/gauge",
      "Tooltip": "GPU utilisation from AIDA64.",
      "PropertyInspectorPath": "ui/monitor.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableCaching": true,
      "States": [
        {
          "Image": "imgs/actions/gauge-key"
        }
      ]
    },
    {
      "Name": "Power",
      "UUID": "com.rescuecraftstudio.sensorline.power",
      "Icon": "imgs/actions/gauge",
      "Tooltip": "Power draw from AIDA64.",
      "PropertyInspectorPath": "ui/monitor.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableCaching": true,
      "States": [
        {
          "Image": "imgs/actions/gauge-key"
        }
      ]
    },
    {
      "Name": "Gauge",
      "UUID": "com.rescuecraftstudio.sensorline.gauge",
      "Icon": "imgs/actions/gauge",
      "Tooltip": "One AIDA64 sensor as a radial gauge, bar, readout, or sparkline.",
      "PropertyInspectorPath": "ui/gauge.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableCaching": true,
      "States": [
        {
          "Image": "imgs/actions/gauge-key"
        }
      ]
    },
    {
      "Name": "Multi",
      "UUID": "com.rescuecraftstudio.sensorline.multi",
      "Icon": "imgs/actions/multi",
      "Tooltip": "Two to four AIDA64 sensors on a single key.",
      "PropertyInspectorPath": "ui/multi.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableCaching": true,
      "States": [
        {
          "Image": "imgs/actions/multi-key"
        }
      ]
    }
  ]
}